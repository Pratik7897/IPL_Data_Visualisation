# ─────────────────────────────────────────────────────────────────
# IPL Sentiment Dashboard — environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────
# Leave blank to use SQLite (local dev, zero config)
# Set to a PostgreSQL URL for production:
DATABASE_URL=postgresql://ipl_user:ipl_pass@localhost:5432/ipl_sentiment

# PostgreSQL container credentials (used by docker-compose)
POSTGRES_DB=ipl_sentiment
POSTGRES_USER=ipl_user
POSTGRES_PASSWORD=ipl_pass

# ── Twitter / X API ──────────────────────────────────────────────
# Get from: https://developer.twitter.com/en/portal/dashboard
# Required for live tweet streaming (dashboard works without it in demo mode)
TWITTER_BEARER_TOKEN=

# ── CricAPI (Phase 2B — ball-by-ball events) ──────────────────────
# Get from: https://cricapi.com  (free tier: 100 calls/day)
CRICAPI_KEY=
# UUID of the live match from CricAPI match list endpoint
MATCH_ID=

# ── Dashboard ────────────────────────────────────────────────────
DASH_PORT=8050
LOG_LEVEL=INFO

# ── pgAdmin (optional debug UI) ──────────────────────────────────
# Access at http://localhost:5050 when started with --profile debug
PGADMIN_PASSWORD=admin
